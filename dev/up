#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
umask 077
if [[ ! -f .env ]]; then
  python3 - <<'PY'
import secrets
from pathlib import Path
database_password = secrets.token_hex(24)
values = {
    'SESSIONDB_DEV_DATABASE_PASSWORD': database_password,
    'SESSIONDB_DATABASE_URL': f'postgres://sessiondb:{database_password}@127.0.0.1:55432/sessiondb',
    'SESSIONDB_S3_ACCESS_KEY_ID': secrets.token_hex(16),
    'SESSIONDB_S3_SECRET_ACCESS_KEY': secrets.token_hex(32),
    'SESSIONDB_API_KEY': secrets.token_urlsafe(32),
}
Path('.env').write_text(''.join(f'{key}={value}\n' for key, value in values.items()))
PY
fi
set -a
source .env
set +a
: "${SESSIONDB_DATABASE_URL:?Set SESSIONDB_DATABASE_URL in .env}"
: "${SESSIONDB_API_KEY:?Set SESSIONDB_API_KEY in .env}"
: "${SESSIONDB_S3_ACCESS_KEY_ID:?Set SESSIONDB_S3_ACCESS_KEY_ID in .env}"
: "${SESSIONDB_S3_SECRET_ACCESS_KEY:?Set SESSIONDB_S3_SECRET_ACCESS_KEY in .env}"
chmod 600 .env
docker compose --env-file .env -f dev/compose.yaml up -d --wait
printf '%s\n' 'Development PostgreSQL and object storage are ready. The shared API key is in .env.'
printf '%s\n' 'Next: source .env with export enabled, build the workspace, run migrations, and start the server. See docs/development.md.'
