{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionDB normalization expectations",
  "type": "object",
  "required": [
    "case"
  ],
  "oneOf": [
    { "required": ["sessions"], "not": { "required": ["error"] } },
    { "required": ["error"], "not": { "required": ["sessions"] } }
  ],
  "additionalProperties": false,
  "properties": {
    "case": {
      "type": "string"
    },
    "error": {
      "const": "unsupported_native_record"
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "key",
        "role",
        "origin",
        "native_ids",
        "parent_key",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system",
            "tool",
            "unknown"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "native_user",
            "model",
            "tool",
            "harness",
            "unknown"
          ]
        },
        "native_role": {
          "type": "string"
        },
        "native_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "parent_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "../docs/openapi.yaml#/components/schemas/FullContentBlock"
          }
        },
        "provider_response_id": {
          "type": "string"
        },
        "provider_usage": {
          "type": "object"
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "key",
        "native_session_id",
        "recorded_cwd",
        "project_ids",
        "messages",
        "events",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "native_session_id": {
          "type": "string"
        },
        "native_agent_id": {
          "type": "string"
        },
        "recorded_cwd": {
          "type": "string"
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "branches": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
