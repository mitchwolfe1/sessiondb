#!/usr/bin/env python3
"""Install SessionDB's on-demand history skill for the current user's coding agents."""

import argparse
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import tempfile


SKILL = Path("skills/sessiondb/SKILL.md")
PREVIOUS = "sessiondb-history"
BEGIN = b"<!-- sessiondb:start -->"
END = b"<!-- sessiondb:end -->"
GUIDANCE = (
    b"Use the `sessiondb` skill when prior work could be useful. "
    b"Search across the team for shared procedures. For a person's decisions, use `--member HANDLE` or "
    b"`--mine`. For this workstation's setup, start with `--local`. When the scope is clear, read SKILL.md "
    b"and run the scoped `sessiondb search --mode hybrid --open-first -- \"task terms\"` in one shell call. "
    b"If you also need to discover a tool, fetch its matching description and argument signature in that "
    b"same batch. Inspect the returned original exchange and cite its message URL."
)


def instruction_file(command, config):
    if command == "claude":
        return config / "CLAUDE.md"
    override = config / "AGENTS.override.md"
    if command == "codex":
        if override.is_file() and override.read_bytes().strip():
            return override
    else:
        for name in ("AGENTS.override.md", "AGENTS.md", "AGENTS.MD", "CLAUDE.md", "CLAUDE.MD"):
            if (config / name).is_file():
                return config / name
    return config / "AGENTS.md"


def with_guidance(path, content):
    newline = b"\r\n" if b"\r\n" in content else b"\n"
    block = newline.join((BEGIN, GUIDANCE, END))
    matches = []
    for name in (SKILL.parent.name, PREVIOUS):
        start = f"<!-- {name}:start -->".encode()
        end = f"<!-- {name}:end -->".encode()
        if start not in content and end not in content:
            continue
        pattern = rb"^" + re.escape(start) + rb"\r?\n.*?^" + re.escape(end) + rb"(?=\r?$)"
        match = re.search(pattern, content, re.MULTILINE | re.DOTALL)
        if content.count(start) != 1 or content.count(end) != 1 or not match:
            raise ValueError(f"{path}: repair the incomplete or duplicate SessionDB instruction markers and rerun")
        matches.append(match.span())
    if matches:
        matches.sort()
        if len(matches) == 2:
            (_, stop), (second, last) = matches
            if second < stop:
                raise ValueError(f"{path}: overlapping SessionDB instruction blocks")
            content = content[:second] + content[last:]
        start, end = matches[0]
        return content[:start] + block + content[end:]
    separator = b""
    if content and not content.endswith(newline * 2):
        separator = newline if content.endswith(b"\n") else newline * 2
    return content + separator + block + newline


def destination(path):
    # Keep existing dotfile links, including a Claude skill linked to the shared one.
    for entry in (path, *path.parents):
        if entry.is_symlink() and not entry.exists():
            raise ValueError(f"{entry}: dangling symlink")
    return path.resolve()


def existing(path):
    if path.is_file():
        return path.read_bytes()
    if path.exists():
        raise ValueError(f"{path}: expected a regular file")
    return None


def install(path, old, new, backup):
    path.parent.mkdir(parents=True, exist_ok=True)
    staged = tempfile.NamedTemporaryFile(dir=path.parent, delete=False)
    tmp = Path(staged.name)
    try:
        with staged:
            staged.write(new)
        current = existing(path)
        if current == new:
            return
        if current != old:
            raise ValueError(f"{path}: changed during installation; rerun to pick up the edit")
        if old is not None:
            tmp.chmod(stat.S_IMODE(path.stat().st_mode))
            if backup:
                with tempfile.NamedTemporaryFile(dir=path.parent, prefix=path.name + ".", suffix=".bak", delete=False) as saved:
                    saved.write(old)
                print(f"Backup: {saved.name}")
        tmp.replace(path)
    finally:
        if tmp.exists():
            tmp.unlink()


def archive(path):
    # A renamed backup inside skills/ could still be discovered by its frontmatter.
    backups = path.parent.parent / "sessiondb-skill-backups"
    backups.mkdir(mode=0o700, exist_ok=True)
    saved = Path(tempfile.mkdtemp(dir=backups)) / path.name
    shutil.move(str(path), saved)
    print(f"Archived {path} at {saved}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="show what would change without writing files")
    args = parser.parse_args()
    home = Path.home()
    detected = []
    skills, guides, previous = set(), set(), set()
    links = {}
    for name, command, env, default in (
        ("Codex", "codex", "CODEX_HOME", ".codex"),
        ("Claude Code", "claude", "CLAUDE_CONFIG_DIR", ".claude"),
        ("Pi", "pi", "PI_CODING_AGENT_DIR", ".pi/agent"),
    ):
        config = Path(os.environ.get(env) or home / default).expanduser()
        if not config.is_dir() and not shutil.which(command):
            continue
        detected.append(name)
        native = destination(config / "skills")
        shared = destination(home / ".agents" / "skills")
        old_native, old_shared = native / PREVIOUS, shared / PREVIOUS
        new_native, new_shared = native / SKILL.parent.name, shared / SKILL.parent.name
        has_native = (new_native / SKILL.name).is_file() or os.path.lexists(old_native)
        has_shared = (new_shared / SKILL.name).is_file() or os.path.lexists(old_shared)
        shared_link = old_native.is_symlink() and old_native.resolve() == old_shared.resolve()
        if os.path.lexists(old_native):
            previous.add(old_native)
        if (command != "claude" or shared_link) and os.path.lexists(old_shared):
            previous.add(old_shared)
        if shared_link and native != shared and not os.path.lexists(new_native):
            links[new_native] = new_shared
        elif command == "claude" or has_native:
            skills.add(destination(new_native / SKILL.name))
        if shared_link or (command != "claude" and (has_shared or not has_native)):
            skills.add(destination(new_shared / SKILL.name))
        guides.add(destination(instruction_file(command, config)))

    if not detected:
        print("No Codex, Claude Code or Pi installation detected.")
        return
    print("Detected: " + ", ".join(detected))
    if not args.dry_run and not shutil.which("sessiondb"):
        if (Path(__file__).resolve().parents[1] / "sessiondb").is_file():
            hint = "install the bundled sessiondb executable in a directory on PATH"
        else:
            hint = "install the CLI from this checkout with 'cargo install --locked --path crates/cli'"
        print(f"For history lookups, {hint}, then run 'sessiondb connect SERVER_URL --member HANDLE'.")
    if skills & guides:
        raise ValueError("a skill file and an instruction file point to the same destination")

    # Check every instruction block before changing any of the detected harnesses.
    skill = (Path(__file__).resolve().parents[1] / SKILL).read_bytes()
    changes = []
    for path in sorted(skills | guides):
        old = existing(path)
        new = skill if path in skills else with_guidance(path, old or b"")
        if new != old:
            changes.append((path, old, new, path in skills))
    if not (changes or previous or links):
        print("SessionDB harness integration is already up to date.")
        return
    for path in previous:
        if any(p.is_relative_to(path) for p in skills | guides):
            raise ValueError(f"An active installation still points inside {path}; update its link before archiving it")
    for path, old, new, backup in changes:
        action = "Update" if old is not None else "Create"
        if args.dry_run:
            print(f"Would {action.lower()} {path}")
        else:
            install(path, old, new, backup)
            print(f"{action} {path}")
    for path, target in sorted(links.items()):
        if args.dry_run:
            print(f"Would link {path} to {target}")
        elif not path.is_symlink() or path.resolve() != target.resolve():
            path.symlink_to(target, target_is_directory=True)
            print(f"Linked {path} to {target}")
    for path in sorted(previous):
        if args.dry_run:
            print(f"Would archive {path}")
        elif os.path.lexists(path):
            archive(path)
    if not args.dry_run:
        print("Start a new agent session to use the SessionDB history skill.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        sys.exit(f"install-harnesses: {error}")
